#!/usr/bin/env bash
# Installs Nginx and configures a 301 redirect for /redirect_me

sudo apt-get update -y
sudo apt-get install -y nginx

echo "Hello World!" | sudo tee /var/www/html/index.html > /dev/null

sudo sed -i '/server_name _;/a location /xyz {\n return 404 "58acb50e-1a";\n }' /etc/nginx/sites-available/default

sudo sed -i "/server_name _;/a location /xyzfoo {\n Ceci n'est pas une page;\n }" /etc/nginx/sites-available/default

sudo service nginx restart
